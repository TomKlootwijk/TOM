# Interpreter, test, and analysis caches are never repository inputs.
**/__pycache__/
*.py[cod]
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.coverage
**/htmlcov/
**/validation/tests.txt

# Reproducible host builds and temporary replay trees stay local.
**/build/
**/dist/
**/tmp/

# These existing sibling release workspaces are retained locally and are not
# part of this repository commit. Exact names avoid hiding future workspaces.
/NHDF_CCD_Cradle_to_Grave_v0.6/
/NHDF_CCD_Cradle_to_Grave_v0.7/
/NHDF_TOMAGI_Literal_Kernel_v0.8.0-LSM1_EXTERNAL_TCB_ORACLE/

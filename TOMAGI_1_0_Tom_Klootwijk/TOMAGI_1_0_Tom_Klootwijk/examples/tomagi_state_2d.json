        "prefix": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 1200 720\" role=\"img\">\n  <title>TOMAGI State64 orbit: theta/rho</title>\n  <desc>Ordered EMIT samples from the authenticated literal-chain trace; every polyline point is an affine projection of theta and rho.</desc>\n  <metadata>source_sha256=f456d0da681ae03ddb40cdc1c4566411b25a24e48d8ab279a9bc94d75a6f9cbd;program_sha256=349e51a5a402b3295d653ad08f00b55d465ffab7e943fb437d196af948487e3e;trace_sha256=aa060ad1cdc25d7e95e2cdc36e1338ede0cced27f4791989b0cc287d01b9a14f;fields=theta,rho</metadata>\n  <rect width=\"1200\" height=\"720\" fill=\"#071a26\"/>\n  <rect x=\"80\" y=\"70\" width=\"1040\" height=\"580\" fill=\"none\" stroke=\"#315d70\" stroke-width=\"2\"/>\n  <line x1=\"80\" y1=\"650\" x2=\"1120\" y2=\"650\" stroke=\"#8fc7ca\"/>\n  <line x1=\"80\" y1=\"70\" x2=\"80\" y2=\"650\" stroke=\"#8fc7ca\"/>\n  <text x=\"80\" y=\"42\" fill=\"#dff9f7\" font-family=\"monospace\" font-size=\"22\">Authenticated State64 projection: (theta, rho)</text>\n  <text x=\"1060\" y=\"690\" fill=\"#8fc7ca\" font-family=\"monospace\" font-size=\"16\">theta</text>\n  <text x=\"20\" y=\"90\" fill=\"#8fc7ca\" font-family=\"monospace\" font-size=\"16\">rho</text>\n  <polyline fill=\"none\" stroke=\"#d9a31a\" stroke-width=\"4\" stroke-linejoin=\"round\" points=\"",

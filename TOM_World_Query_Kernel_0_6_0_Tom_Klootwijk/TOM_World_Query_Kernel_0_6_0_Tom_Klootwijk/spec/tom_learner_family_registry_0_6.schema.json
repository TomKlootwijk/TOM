{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/tom/tom-learner-family-registry-0.6.schema.json",
  "title": "TOM Learner 0.2 finite typed hypothesis-family registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "seed_sha256", "partition_policy_hash", "family_order", "families", "content_hash"],
  "properties": {
    "schema": {"const": "TOM-LEARNER-0.2-FAMILY-REGISTRY-1.0"},
    "id": {"const": "registry:learner-family:0.2"},
    "seed_sha256": {"$ref": "#/$defs/hash"},
    "partition_policy_hash": {"$ref": "#/$defs/hash"},
    "family_order": {
      "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "families": {
      "type": "array", "minItems": 1, "maxItems": 16,
      "items": {"$ref": "#/$defs/family"}
    },
    "content_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "rational": {
      "type": "object", "additionalProperties": false,
      "required": ["num", "den"],
      "properties": {
        "num": {"type": "integer"},
        "den": {"type": "integer", "minimum": 1}
      }
    },
    "expression": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["op"], "properties": {"op": {"const": "x"}}},
        {"type": "object", "additionalProperties": false, "required": ["op", "value"], "properties": {"op": {"const": "const"}, "value": {"$ref": "#/$defs/rational"}}},
        {"type": "object", "additionalProperties": false, "required": ["op", "arg"], "properties": {"op": {"enum": ["neg", "abs", "square"]}, "arg": {"$ref": "#/$defs/expression"}}},
        {"type": "object", "additionalProperties": false, "required": ["op", "left", "right"], "properties": {"op": {"enum": ["add", "sub", "mul"]}, "left": {"$ref": "#/$defs/expression"}, "right": {"$ref": "#/$defs/expression"}}}
      ]
    },
    "baseCandidate": {
      "type": "object",
      "required": ["schema", "id", "family_id", "complexity", "content_hash"],
      "properties": {
        "schema": {"const": "TOM-LEARNER-0.2-CANDIDATE-1.0"},
        "id": {"type": "string", "minLength": 1},
        "family_id": {"type": "string", "minLength": 1},
        "complexity": {"type": "integer", "minimum": 1, "maximum": 64},
        "content_hash": {"$ref": "#/$defs/hash"}
      }
    },
    "polynomialCandidate": {
      "allOf": [
        {"$ref": "#/$defs/baseCandidate"},
        {
          "type": "object", "additionalProperties": false,
          "required": ["schema", "id", "family_id", "complexity", "coefficients", "content_hash"],
          "properties": {
            "schema": {"const": "TOM-LEARNER-0.2-CANDIDATE-1.0"},
            "id": {"type": "string", "minLength": 1},
            "family_id": {"const": "family:polynomial:0.2"},
            "complexity": {"type": "integer", "minimum": 1, "maximum": 3},
            "coefficients": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/rational"}},
            "content_hash": {"$ref": "#/$defs/hash"}
          }
        }
      ]
    },
    "piecewiseCandidate": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "id", "family_id", "complexity", "breakpoint", "left", "right", "content_hash"],
      "properties": {
        "schema": {"const": "TOM-LEARNER-0.2-CANDIDATE-1.0"},
        "id": {"type": "string", "minLength": 1},
        "family_id": {"const": "family:piecewise-affine:0.2"},
        "complexity": {"type": "integer", "minimum": 1, "maximum": 8},
        "breakpoint": {"$ref": "#/$defs/rational"},
        "left": {"$ref": "#/$defs/affineBranch"},
        "right": {"$ref": "#/$defs/affineBranch"},
        "content_hash": {"$ref": "#/$defs/hash"}
      }
    },
    "affineBranch": {
      "type": "object", "additionalProperties": false,
      "required": ["slope", "intercept"],
      "properties": {"slope": {"$ref": "#/$defs/rational"}, "intercept": {"$ref": "#/$defs/rational"}}
    },
    "tableCandidate": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "id", "family_id", "complexity", "entries", "content_hash"],
      "properties": {
        "schema": {"const": "TOM-LEARNER-0.2-CANDIDATE-1.0"},
        "id": {"type": "string", "minLength": 1},
        "family_id": {"const": "family:transition-table:0.2"},
        "complexity": {"type": "integer", "minimum": 1, "maximum": 16},
        "entries": {
          "type": "array", "minItems": 1, "maxItems": 16,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["input", "output"],
            "properties": {"input": {"type": "string"}, "output": {"type": "string"}}
          }
        },
        "content_hash": {"$ref": "#/$defs/hash"}
      }
    },
    "expressionCandidate": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "id", "family_id", "complexity", "tree", "content_hash"],
      "properties": {
        "schema": {"const": "TOM-LEARNER-0.2-CANDIDATE-1.0"},
        "id": {"type": "string", "minLength": 1},
        "family_id": {"const": "family:expression-tree:0.2"},
        "complexity": {"type": "integer", "minimum": 1, "maximum": 5},
        "tree": {"$ref": "#/$defs/expression"},
        "content_hash": {"$ref": "#/$defs/hash"}
      }
    },
    "candidate": {
      "oneOf": [
        {"$ref": "#/$defs/polynomialCandidate"},
        {"$ref": "#/$defs/piecewiseCandidate"},
        {"$ref": "#/$defs/tableCandidate"},
        {"$ref": "#/$defs/expressionCandidate"}
      ]
    },
    "family": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "id", "semantic_version", "kind", "domain", "codomain", "search_budget", "candidate_order", "candidates", "content_hash"],
      "properties": {
        "schema": {"const": "TOM-LEARNER-0.2-HYPOTHESIS-FAMILY-1.0"},
        "id": {"enum": ["family:polynomial:0.2", "family:piecewise-affine:0.2", "family:transition-table:0.2", "family:expression-tree:0.2"]},
        "semantic_version": {"const": "0.2.0"},
        "kind": {"enum": ["bounded-exact-polynomial", "bounded-piecewise-affine", "finite-transition-table", "bounded-expression-tree"]},
        "domain": {"type": "string", "minLength": 1},
        "codomain": {"type": "string", "minLength": 1},
        "operation_registry": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "search_budget": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "integer", "minimum": 0}},
        "candidate_order": {"type": "string", "minLength": 1},
        "candidates": {"type": "array", "minItems": 1, "maxItems": 4096, "items": {"$ref": "#/$defs/candidate"}},
        "content_hash": {"$ref": "#/$defs/hash"}
      }
    }
  }
}

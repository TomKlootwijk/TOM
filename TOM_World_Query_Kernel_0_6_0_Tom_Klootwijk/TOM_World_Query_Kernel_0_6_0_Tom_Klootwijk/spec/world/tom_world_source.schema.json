{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tom.invalid/schema/tom-world-source-0.1.json",
  "title": "Unhashed literal TOM world source",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "message", "provenance", "blobs", "records"],
  "properties": {
    "schema": {"const": "TOM-WORLD-SOURCE-0.1"},
    "message": {"type": "string"},
    "provenance": {"type": "object"},
    "blobs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "media_type": {"type": "string", "minLength": 1}
        }
      }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["schema", "record_type", "id", "version", "dependencies", "payload", "provenance"],
        "properties": {
          "schema": {"const": "TOM-WORLD-RECORD-0.1"},
          "record_type": {"type": "string"},
          "id": {"type": "string", "minLength": 1},
          "version": {"type": "integer", "minimum": 1},
          "dependencies": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "payload": {"type": "object"},
          "provenance": {"type": "object"}
        }
      }
    }
  }
}

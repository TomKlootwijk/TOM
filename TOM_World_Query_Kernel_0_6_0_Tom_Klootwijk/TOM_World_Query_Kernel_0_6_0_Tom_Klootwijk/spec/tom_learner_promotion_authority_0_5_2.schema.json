{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/tom/tom-learner-promotion-authority-0.5.2.schema.json",
  "title": "TOM Learner promotion/evidence transaction authority 0.5.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "program_hash", "inputs_hash", "steps", "value", "content_hash"],
  "properties": {
    "schema": {"const": "TOMAGI-FORMAL-RESULT-1.0"},
    "program_hash": {"$ref": "#/$defs/hash"},
    "inputs_hash": {"$ref": "#/$defs/hash"},
    "steps": {"type": "integer", "minimum": 1},
    "value": {"$ref": "#/$defs/result"},
    "content_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "addressed": {
      "type": "object",
      "required": ["content_hash"],
      "properties": {"content_hash": {"$ref": "#/$defs/hash"}}
    },
    "descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema", "profile", "seed_sha256", "base_world_hash", "base_handoff_hash",
        "corrective_handoff_hash", "namespaces", "head_namespace", "record_encoding",
        "publication_rule", "content_hash"
      ],
      "properties": {
        "schema": {"const": "TOMAGI-IMMUTABLE-STORE-DESCRIPTOR-1.0"},
        "profile": {"const": "TOM-LEARNER-0.1-PROMOTION-AUTHORITY"},
        "seed_sha256": {"$ref": "#/$defs/hash"},
        "base_world_hash": {"$ref": "#/$defs/hash"},
        "base_handoff_hash": {"$ref": "#/$defs/hash"},
        "corrective_handoff_hash": {"$ref": "#/$defs/hash"},
        "namespaces": {
          "type": "array",
          "prefixItems": [
            {"const": "commits"}, {"const": "objects"},
            {"const": "snapshots"}, {"const": "transactions"}
          ],
          "items": false
        },
        "head_namespace": {"const": "commits"},
        "record_encoding": {"const": "canonical-json-plus-lf"},
        "publication_rule": {"const": "write-immutable-records-then-cas-head"},
        "content_hash": {"$ref": "#/$defs/hash"}
      }
    },
    "write": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "record"],
      "properties": {
        "namespace": {"enum": ["commits", "objects", "snapshots", "transactions"]},
        "record": {"$ref": "#/$defs/addressed"}
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema", "profile", "sequence", "expected_head", "replacement_head",
        "required_hashes", "writes", "content_hash"
      ],
      "properties": {
        "schema": {"const": "TOMAGI-IMMUTABLE-PUBLICATION-1.0"},
        "profile": {"const": "TOM-LEARNER-0.1-PROMOTION-AUTHORITY"},
        "sequence": {"type": "integer", "minimum": 0},
        "expected_head": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/hash"}]},
        "replacement_head": {"$ref": "#/$defs/hash"},
        "required_hashes": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"$ref": "#/$defs/hash"}
        },
        "writes": {
          "type": "array", "minItems": 1,
          "items": {"$ref": "#/$defs/write"}
        },
        "content_hash": {"$ref": "#/$defs/hash"}
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema", "profile", "store_descriptor", "publications",
        "terminal_head", "content_hash"
      ],
      "properties": {
        "schema": {"const": "TOMAGI-IMMUTABLE-PUBLICATION-PLAN-1.0"},
        "profile": {"const": "TOM-LEARNER-0.1-PROMOTION-AUTHORITY"},
        "store_descriptor": {"$ref": "#/$defs/descriptor"},
        "publications": {
          "type": "array", "minItems": 1,
          "items": {"$ref": "#/$defs/publication"}
        },
        "terminal_head": {"$ref": "#/$defs/hash"},
        "content_hash": {"$ref": "#/$defs/hash"}
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema", "profile", "authority_program_hash", "learner_program_hash",
        "learner_result_hash", "learner_value_hash", "context_hash",
        "corrective_handoff_hash", "token_registry_hash", "dataset_count",
        "accepted_count", "rejected_count", "publication_count", "terminal_head",
        "terminal_snapshot_hash", "publication_plan", "claim_boundary", "content_hash"
      ],
      "properties": {
        "schema": {"const": "TOM-LEARNER-PROMOTION-AUTHORITY-RESULT-0.5.2"},
        "profile": {"const": "TOM-LEARNER-0.1-PROMOTION-AUTHORITY"},
        "authority_program_hash": {"$ref": "#/$defs/hash"},
        "learner_program_hash": {"$ref": "#/$defs/hash"},
        "learner_result_hash": {"$ref": "#/$defs/hash"},
        "learner_value_hash": {"$ref": "#/$defs/hash"},
        "context_hash": {"$ref": "#/$defs/hash"},
        "corrective_handoff_hash": {"$ref": "#/$defs/hash"},
        "token_registry_hash": {"$ref": "#/$defs/hash"},
        "dataset_count": {"const": 19},
        "accepted_count": {"const": 12},
        "rejected_count": {"const": 7},
        "publication_count": {"const": 20},
        "terminal_head": {"$ref": "#/$defs/hash"},
        "terminal_snapshot_hash": {"$ref": "#/$defs/hash"},
        "publication_plan": {"$ref": "#/$defs/plan"},
        "claim_boundary": {"type": "string", "minLength": 1},
        "content_hash": {"$ref": "#/$defs/hash"}
      }
    }
  }
}
